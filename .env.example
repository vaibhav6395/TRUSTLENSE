# Copy to .env and replace all sample values before running locally.
POSTGRES_PASSWORD=replace-with-a-unique-local-database-password
DB_USERNAME=trustlens
DB_PASSWORD=replace-with-the-same-unique-local-database-password
DB_URL=jdbc:postgresql://localhost:5432/trustlens
COOKIE_SECURE=false
CORS_ALLOWED_ORIGINS=http://localhost:5173
DEMO_DATA_ENABLED=false
# Only set these when explicitly enabling synthetic local demo seeding.
DEMO_FACULTY_PASSWORD=replace-with-a-unique-password-at-least-14-characters
DEMO_ADMIN_PASSWORD=replace-with-a-different-unique-password-at-least-14-characters
